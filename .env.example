FFMPEG_PATH=
FFPROBE_PATH=
AI_WHISPER_MODEL=turbo
AI_WHISPER_DEVICE=auto
AI_WHISPER_COMPUTE_TYPE=auto
MAX_FILE_MB=10000
DEFAULT_LANG=ko
LANG_MODE=default
DIARIZATION_ENABLED=false
DIARIZATION_PROVIDER=pyannote
DIARIZATION_SOURCE=auto
DIARIZATION_HF_TOKEN=
AI_DIARIZATION_MODEL_PATH=.models/pyannote/speaker-diarization-3.1
AI_DIARIZATION_REPO_MAIN=pyannote/speaker-diarization-3.1
AI_DIARIZATION_REPO_SEGMENTATION=pyannote/segmentation-3.0
AI_DIARIZATION_REPO_EMBEDDING=pyannote/wespeaker-voxceleb-resnet34-LM
AI_DIARIZATION_REPO_COMMUNITY=pyannote/speaker-diarization-community-1
DIARIZATION_MIN_SPEAKERS=
DIARIZATION_MAX_SPEAKERS=
DIARIZATION_DEVICE=auto
# 화자 구분 ON일 때: 단어 타임스탬프로 STT·다이어리제이션 정밀 정렬(기본 true)
DIARIZATION_REFINE_WORD_LEVEL=true
# 짧은 끼어들기(A-B-A)를 같은 화자로 병합하는 최대 길이(초). 0이면 병합 안 함
DIARIZATION_SMOOTH_SHORT_SPIKE_SEC=1.0
# pyannote 클러스터링 threshold(낮을수록 화자 수 증가 경향). 비우면 모델 기본값
DIARIZATION_CLUSTERING_THRESHOLD=
TIMESTAMP_IN_TRANSCRIPT=true
SPEAKER_LABEL_STYLE=ko
